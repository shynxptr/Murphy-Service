# ==========================================
# KONFIGURASI BOT DISCORD HUMAS
# ==========================================
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_GUILD_ID=your_server_guild_id_here

# Channel internal untuk notifikasi DM masuk / PIC keluar / aspirasi baru
NOTIF_CHANNEL_ID=

# Channel khusus untuk Fallback Private Thread jika DM member tertutup
FALLBACK_CHANNEL_ID=

# Opsional: Role ID Partner (jika ingin auto-cek/kelola role)
PARTNER_ROLE_ID=

# ==========================================
# KONFIGURASI WEB CONTROL PANEL
# ==========================================
PORT=3000
WEB_BASE_URL=http://localhost:3000

# Kunci rahasia untuk sesi login JWT (ganti dengan string acak panjang!)
JWT_SECRET=ganti_dengan_secret_acak_minimal_32_karakter

# Daftar akun admin tertutup (tanpa halaman register publik)
# Format per akun: username:password:nama_tampilan:role
# Role yang didukung: superadmin | staff
# Pisahkan beberapa akun dengan koma (,)
# Password bisa plain text atau hash bcrypt (jalankan: npm run hash -- passwordmu)
ADMIN_ACCOUNTS=ketua:admin123:Ketua Humas:superadmin,staff1:staff123:Staff Humas:staff

# ==========================================
# PENGATURAN DATABASE & STORAGE
# ==========================================
DB_PATH=./data/humas.db
UPLOADS_DIR=./uploads
